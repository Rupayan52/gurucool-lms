generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  passwordHash String
  role         Role           @default(STUDENT)
  tokenVersion Int            @default(0)
  createdAt    DateTime       @default(now())
  
  // A teacher can mentor many subjects
  mentoredSubjects Subject[]  @relation("TeacherSubjects")
  
  // A student has many registrations
  registrations    Registration[]
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model Subject {
  id            String         @id @default(uuid())
  name          String         @unique // e.g., "Physics", "Chemistry"
  description   String?
  
  // A subject can be taught by one designated faculty member in this Phygital model
  teacherId     String?
  teacher       User?          @relation("TeacherSubjects", fields: [teacherId], references: [id])
  
  registrations Registration[]
}

model Registration {
  id         String   @id @default(uuid())
  studentId  String
  subjectId  String
  createdAt  DateTime @default(now())
  
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId]) // Prevent duplicate registrations
}
